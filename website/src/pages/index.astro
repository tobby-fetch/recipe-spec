---
const title = "Recipe Spec";
const tagline = "One YAML document that says exactly what your software delivery is made of.";
const description =
  "The open specification for Recipes — declarative, signable, fully pinned descriptions of the OCI artifacts that make up a software delivery. The format that drives Tobby, open to every tool.";
const repo = "https://github.com/tobby-fetch/recipe-spec";
const tobbySite = "https://tobby-fetch.github.io/tobby-fetch/";
const ships = ["Specification", "JSON Schemas", "Examples", "Go SDK (first tagged release)"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={tagline} />
    <meta property="og:type" content="website" />
    <title>{title} — {tagline}</title>
    <style>
      :root {
        color-scheme: dark light;
        --bg: #0b0d12;
        --bg-glow: 240 169 46; /* amber, used in radial glow */
        --fg: #e8eaf0;
        --muted: #949aab;
        --accent: #f0a92e;
        --accent-soft: #ffc25c;
        --hair: rgba(255, 255, 255, 0.09);
        --chip: rgba(255, 255, 255, 0.05);
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #faf9f6;
          --bg-glow: 201 126 18;
          --fg: #1a1d24;
          --muted: #5f6472;
          --accent: #c97e12;
          --accent-soft: #a9660b;
          --hair: rgba(0, 0, 0, 0.1);
          --chip: rgba(0, 0, 0, 0.04);
        }
      }

      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }

      body {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 2rem 1.5rem;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI",
          Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow: hidden;
      }

      /* soft amber glow behind the content */
      body::before {
        content: "";
        position: fixed;
        inset: -20vmax;
        background:
          radial-gradient(
            42vmax 42vmax at 50% 34%,
            rgb(var(--bg-glow) / 0.14),
            transparent 60%
          );
        pointer-events: none;
        z-index: 0;
      }

      main {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 40rem;
        animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      .mark {
        width: 4.25rem;
        height: 4.25rem;
        margin: 0 auto 1.5rem;
        display: block;
        color: var(--accent);
      }
      .mark .ingredient {
        animation: pin 3.6s ease-in-out infinite;
      }
      .mark .ingredient:nth-child(2) { animation-delay: 0.4s; }
      .mark .ingredient:nth-child(3) { animation-delay: 0.8s; }

      h1 {
        font-size: clamp(2.2rem, 8vw, 3.4rem);
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0 0 0.85rem;
        font-weight: 700;
      }
      h1 .dot { color: var(--accent); }

      .tagline {
        font-size: clamp(1.05rem, 3.4vw, 1.35rem);
        line-height: 1.45;
        margin: 0 auto;
        max-width: 32rem;
        color: var(--fg);
        font-weight: 500;
      }

      .lede {
        font-size: clamp(0.92rem, 2.6vw, 1rem);
        line-height: 1.6;
        margin: 1rem auto 0;
        max-width: 34rem;
        color: var(--muted);
      }
      .lede a {
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid var(--hair);
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .lede a:hover {
        color: var(--accent);
        border-color: var(--accent);
      }

      .ships {
        list-style: none;
        padding: 0;
        margin: 1.75rem auto 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
      }
      .ships li {
        font-size: 0.8rem;
        letter-spacing: 0.01em;
        color: var(--fg);
        padding: 0.35rem 0.75rem;
        border: 1px solid var(--hair);
        border-radius: 999px;
        background: var(--chip);
        white-space: nowrap;
      }

      .badge {
        margin-top: 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .badge .pulse {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0.5);
        animation: pulse 2.2s ease-out infinite;
      }

      .links {
        margin-top: 1.5rem;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .links a {
        color: var(--muted);
        text-decoration: none;
        border-bottom: 1px solid var(--hair);
        padding-bottom: 1px;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .links a:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .links .sep {
        margin: 0 0.6rem;
        opacity: 0.5;
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes pin {
        0%, 100% { opacity: 0.45; }
        15%, 55% { opacity: 1; }
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0.5); }
        70% { box-shadow: 0 0 0 0.5rem rgb(var(--bg-glow) / 0); }
        100% { box-shadow: 0 0 0 0 rgb(var(--bg-glow) / 0); }
      }

      @media (prefers-reduced-motion: reduce) {
        main { animation: none; }
        .mark .ingredient { animation: none; opacity: 1; }
        .badge .pulse { animation: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <svg
        class="mark"
        viewBox="0 0 48 48"
        fill="none"
        role="img"
        aria-label="Recipe Spec logo"
      >
        <!-- the recipe: a document card -->
        <rect
          x="11.5"
          y="7.5"
          width="25"
          height="33"
          rx="3"
          stroke="currentColor"
          stroke-width="1.5"
          fill="currentColor"
          fill-opacity="0.05"
        />
        <!-- title line -->
        <path
          d="M16.5 13.5h10"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          opacity="0.85"
        />
        <!-- ingredient rows: an OCI cube, then its pinned reference -->
        <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <g class="ingredient">
            <path
              d="M19 19.4l2.4 1.4v2.6L19 24.8l-2.4-1.4v-2.6l2.4-1.4z"
              stroke-width="1.2"
              fill="currentColor"
              fill-opacity="0.18"
            />
            <path d="M25 22h7" stroke-width="1.4" opacity="0.55" />
          </g>
          <g class="ingredient">
            <path
              d="M19 26.4l2.4 1.4v2.6L19 31.8l-2.4-1.4v-2.6l2.4-1.4z"
              stroke-width="1.2"
              fill="currentColor"
              fill-opacity="0.18"
            />
            <path d="M25 29h7" stroke-width="1.4" opacity="0.55" />
          </g>
          <g class="ingredient">
            <path
              d="M19 33.4l2.4 1.4v2.6L19 38.8l-2.4-1.4v-2.6l2.4-1.4z"
              stroke-width="1.2"
              fill="currentColor"
              fill-opacity="0.18"
            />
            <path d="M25 36h5" stroke-width="1.4" opacity="0.55" />
          </g>
        </g>
      </svg>

      <h1>Recipe Spec<span class="dot">.</span></h1>
      <p class="tagline">{tagline}</p>
      <p class="lede">
        A <strong>Recipe</strong> pins every ingredient of a software delivery
        — container images, Helm charts, AI models, files — to an exact OCI
        digest, so one signature attests the whole delivery. It is the format
        that drives <a href={tobbySite} rel="noopener">Tobby</a> across network
        zones, and it is published here — specification, JSON Schemas, and
        examples, with a Go SDK landing at the first tagged release — under
        Apache-2.0, so any tool can read, validate, and emit Recipes.
      </p>

      <ul class="ships">
        {ships.map((item) => <li>{item}</li>)}
      </ul>

      <span class="badge"><span class="pulse"></span>Specification in progress</span>

      <p class="links">
        <a href={repo} rel="noopener">github.com/tobby-fetch/recipe-spec</a>
        <span class="sep">·</span>
        <a href={tobbySite} rel="noopener">Meet Tobby</a>
      </p>
    </main>
  </body>
</html>
